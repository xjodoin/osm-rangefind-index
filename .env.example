# Direct Cloudflare R2/S3 configuration (no rclone dependency).
R2_BUCKET=osm-index
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
# Optional key prefix within the bucket.
#R2_PREFIX=

# One shared request pool batches object operations across every active shard
# upload. Two shard lanes overlap R2 latency while the next shard builds; the
# pending depth bounds local artifacts awaiting upload/cleanup.
R2_REQUEST_CONCURRENCY=16
R2_UPLOAD_ATTEMPTS=6
R2_UPLOAD_LANES=2
R2_UPLOAD_QUEUE_DEPTH=4

# Adaptive acquisition pipeline. New CPU-heavy stages wait when Linux reports
# less available memory or sustained memory pressure; current work continues.
#INDEX_PIPELINE_MIN_AVAILABLE_GIB=6
#INDEX_PIPELINE_MAX_MEMORY_PSI=2
#OSM_EXTRACT_HEAP_MB=8192
#ADDRESS_ENRICHMENT_HEAP_MB=8192
#INDEX_DISK_ADMISSION_POLL_MS=2000

# Acquisition stops cleanly before extraction would consume the filesystem's
# safety reserve. Concurrent extraction reservations are counted separately.
INDEX_MIN_FREE_GIB=24
# Short source metadata requests are retried at the region level. Completed
# regions are persisted, so exhausting these attempts never restarts the full
# planet acquisition from zero.
SOURCE_REQUEST_TIMEOUT_MS=30000
ACQUISITION_MAX_ATTEMPTS=4
ACQUISITION_RETRY_BASE_MS=10000
# Large Geofabrik PBF downloads need a whole-transfer timeout, distinct from
# short metadata/source requests (default: 30 minutes).
PBF_DOWNLOAD_TIMEOUT_MS=1800000

# The final cross-shard suggest_prefix routing merge runs in an isolated child
# process so the long-lived orchestrator stays small. The production host has
# enough RAM for a larger heap during this one bounded operation.
TEXT_ROUTING_HEAP_MB=12288
# The root merge groups sorted autocomplete keys by this physical prefix
# depth. Ten means "s|" plus eight normalized characters, keeping common
# planet-scale prefixes bounded without changing query behavior.
SUGGEST_ROUTING_BASE_SHARD_DEPTH=10
SUGGEST_ROUTING_MAX_SHARD_DEPTH=14
SUGGEST_ROUTING_HEAP_MB=12288

# Corpus diffs use an id/hash map proportional to the region size. Isolating
# it lets the host use available RAM for large regions and reclaim it fully
# before the next shard.
CORPUS_DIFF_HEAP_MB=16384

# Road extraction and CRP/MLD route-graph builds run in disposable child
# processes. This is a heap ceiling, not a reservation; large regions can use
# it without leaving the long-lived orchestrator expanded afterward.
ROAD_INDEX_HEAP_MB=16384

# Optional provider-neutral civic/postal enrichment configuration. Copy
# address-sources.example.json to address-sources.json, or point at another
# file. Sources are cached once under work/address-sources and partitioned into
# configured regional shards while the corpus is extracted.
#ADDRESS_SOURCES_CONFIG=/srv/osm-rangefind-index/address-sources.json

# Required when an address source uses provider=openaddresses-batch. Create a
# free programmatic token in your OpenAddresses account. It is sent only to
# the authenticated download endpoint and is never written to state or logs.
#OPENADDRESSES_TOKEN=...
