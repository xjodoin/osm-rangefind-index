{
  "name": "osm-rangefind-index",
  "version": "0.1.0",
  "private": true,
  "description": "Scheduled pipeline: build and incrementally update a sharded Rangefind OSM index and publish it to Cloudflare R2.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "benchmark:addresses": "node scripts/benchmark_address_partition.mjs",
    "benchmark:roads": "node scripts/benchmark_road_index.mjs",
    "update": "node scripts/update_index.mjs",
    "update:roads": "node scripts/update_index.mjs --roads-only",
    "update:dry": "node scripts/update_index.mjs --no-upload",
    "refresh:root-lexicon": "scripts/refresh_root_lexicon.sh",
    "gc:r2": "scripts/r2_gc.sh",
    "status": "node scripts/update_index.mjs --status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "rangefind": "^0.4.14"
  }
}
